# =========================================================================
# Ghar Sathi - Production Google Cloud Run Environment Configuration
# Copy this file to .env.cloud and set your real cloud secrets before deploying.
# CAUTION: Never commit .env.cloud to version control!
# =========================================================================

# Django Core Security
DEBUG=False
SECRET_KEY=generate-a-strong-50-char-production-secret-key-gharsathi-prod

# Cloud SQL / Managed PostgreSQL Connection String
# Format: postgresql://<DB_USER>:<DB_PASSWORD>@<CLOUD_SQL_IP_OR_HOST>:5432/<DB_NAME>
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_CLOUD_DB_HOST:5432/gharsathi_db

# Production Domain & Host Bindings
ALLOWED_HOSTS=gharsathi.in,www.gharsathi.in,api.gharsathi.in,.run.app,.web.app,.firebaseapp.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://gharsathi.in,https://www.gharsathi.in,https://api.gharsathi.in
CSRF_TRUSTED_ORIGINS=https://gharsathi.in,https://www.gharsathi.in,https://api.gharsathi.in,https://*.run.app,https://*.web.app,https://*.firebaseapp.com

# SSL & Reverse Proxy Security (Cloud Run terminates SSL at Google Edge)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# SMS OTP Transactional Gateway (Fast2SMS / Twilio)
SMS_PROVIDER=fast2sms
FAST2SMS_API_KEY=your_fast2sms_api_key_here
OTP_EXPIRATION_MINUTES=5

# Razorpay Production / Sandbox Payment Gateway
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Optional Redis Cache / Channels Layer (Memory layer fallback used if unset)
# REDIS_URL=redis://10.x.x.x:6379/0
